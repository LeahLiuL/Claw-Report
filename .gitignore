# Python
__pycache__/
*.pyc
venv/
.venv/

# Local secrets / temp / build cache
*.local
.update_token
/tmp/
.cache/
*.log
_site/

# WorkBuddy internals (memory, etc.)
.workbuddy/

# ROB auto pipeline local artifacts (xlsx regenerated daily, not for git)
rob_data/*.xlsx

# ROB 历史 CSV 的一次性备份(已入库, 不重复提交)
rob_data/rob_history*.bak*
rob_data/rob_history.backup_*.csv
# 同步脚本产生的各类 .bak-YYYYmmdd-HHMM 备份(含 rob_results.json 等)
rob_data/*.bak-*

# sync_templates.py 的模板备份(本地回滚用, 绝不入库)
rob_data/tpl_backup/

# 本地临时/调试产物(不入库)
_dm_latest.html
cul_daily_movement.bak-*.html
draft_preview.html
.wip_backup*/

# 本地大数据文件(绝不入库): bapfile 数据库/Excel 及下载残留
# auto_update.py 用的是 git add -u(不碰未跟踪文件), 这里做防御 —— 防止将来有人用
# git add -A 时把 400+MB 塞进历史(git 历史会永久膨胀, 无法简单删除)
bapfile.db
*.db

# 全字段报告库的 xlsx 原件归档(~500MB/1.7万封, 绝不入库; db 已被 *.db 忽略)
rob_data/report_archive/
rob_data/reports.db.bak_*
rob_data/diag_report_fields_dump.txt
rob_data/collect_full.log
rob_data/parse_full.log
Vessel Bapfile*.xlsx
Vessel Bapfile.xlsx.dl.*
site/data/

# git 操作互斥锁文件(2026-09-24: 防多自动化并发损坏 .git, 见 git_op_lock.py)
.git_op.lock

# build 阶段自动吸收的新航线码(本机运行产物, 每轮 updated 时间戳都会变)。
# 若提交进 git: ①每轮工作区必脏 → pull 易冲突; ②历史里塞满无意义的时间戳 diff。
# 各台机器各自维护自己的副本即可(各自吸收各自扫到的新航线)。
dynamic_lanes.json
_backup_rename_harmony_*/
