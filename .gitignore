# Python
__pycache__/
*.pyc
venv/
.venv/

# Local secrets / temp / build cache
*.local
.update_token
/tmp/
.cache/
*.log
_site/

# WorkBuddy internals (memory, etc.)
.workbuddy/

# ROB auto pipeline local artifacts (xlsx regenerated daily, not for git)
rob_data/*.xlsx

# ROB 历史 CSV 的一次性备份(已入库, 不重复提交)
rob_data/rob_history*.bak*
rob_data/rob_history.backup_*.csv
# 同步脚本产生的各类 .bak-YYYYmmdd-HHMM 备份(含 rob_results.json 等)
rob_data/*.bak-*

# 本地临时/调试产物(不入库)
_dm_latest.html
cul_daily_movement.bak-*.html
draft_preview.html
.wip_backup*/

# 本地大数据文件(绝不入库): bapfile 数据库/Excel 及下载残留
# auto_update.py 用的是 git add -u(不碰未跟踪文件), 这里做防御 —— 防止将来有人用
# git add -A 时把 400+MB 塞进历史(git 历史会永久膨胀, 无法简单删除)
bapfile.db
*.db
Vessel Bapfile*.xlsx
Vessel Bapfile.xlsx.dl.*
site/data/
